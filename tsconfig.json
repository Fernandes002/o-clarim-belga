{
  "compilerOptions": {
    /* Opções Básicas e Alvo de Compilação */
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,

    /* Integração com Bundler (Vite) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": true,

    /* Rigor de Tipagem (Padrão Big Tech para evitar quebras em produção) */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,

    /* Qualidade de Código e Análise Estática */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    
    // Evita erros comuns de leitura de índices indefinidos em arrays/objetos (ex: array[0].prop)
    "noUncheckedIndexedAccess": true,

    /* Mapeamento de Caminhos (Sincronizado com vite.config.ts) */
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@root/*": [
        "./*"
      ]
    },

    /* Suporte a Decoradores (mantido para compatibilidade se necessário) */
    "experimentalDecorators": true,

    /* Tipos Globais */
    "types": [
      "vite/client"
    ]
  },
  /* Otimização de Escopo do Compilador */
  "include": [
    "src/**/*",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}