# =========================================================================
# O Clarim Belga - Configuração de Variáveis de Ambiente (.env.example)
# Padrão Corporativo para Desenvolvimento e Implantação de Alta Escala
# =========================================================================

# --- INTEGRAÇÃO OBRIGATÓRIA GOOGLE AI STUDIO / CLOUD RUN ---

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"


# --- CONFIGURAÇÕES DE INTELIGÊNCIA ARTIFICIAL (Modelos Gemini) ---

# Modelo padrão do Gemini para o processamento de resumos, traduções e interações
# - gemini-3.5-flash: Modelo estável de alta performance, velocidade e excelente capacidade agentica.
# - gemini-3.1-pro: Recomendado para análises profundas de dados históricos/econômicos que demandem raciocínio avançado.
GEMINI_MODEL="gemini-3.5-flash"


# --- CONFIGURAÇÕES DO SERVIDOR (Node.js/Express) ---

# Porta local para execução do servidor backend de dados
PORT=3000

# Ambiente de execução atual ("development" | "production" | "test")
# Em "production", as bibliotecas aplicam otimizações de segurança e logs reduzidos.
NODE_ENV="development"


# --- LOCALIZAÇÃO E TRADUÇÃO (Foco Bélgica) ---

# Define a cultura padrão de fallback para tratamento de números, datas e moedas (Euro)
# Opções suportadas para o contexto belga: 
# - nl-BE (Holandês/Flamengo Belga)
# - fr-BE (Francês Belga)
# - de-BE (Alemão Belga)
DEFAULT_LOCALE="nl-BE"
SUPPORTED_LOCALES="nl-BE,fr-BE,de-BE,en"