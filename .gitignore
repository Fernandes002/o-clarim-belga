# =========================================================================
# O Clarim Belga - Configuração de Controle de Versão (Git)
# Padrão de Produção para Projetos Modernos (Vite, TypeScript, Node.js)
# =========================================================================

# --- Dependências e Caches de Pacotes ---
node_modules/
.pnpm-store/
.npm/
.yarn-cache/

# --- builds, Compilações e Caches do Compilador ---
dist/
build/
out/
server.js
*.tsbuildinfo

# IMPORTANTÍSSIMO para o Vite:
# O Vite cria esta pasta de cache local durante o pré-empacotamento de dependências.
# Se enviada ao Git, ela gera conflitos de caminhos absolutos entre desenvolvedores.
.vite/

# --- Testes, Relatórios e Métricas de Cobertura ---
coverage/
.nyc_output/
.lighthouse/
.clinic/

# --- Logs de Sistema e Erros de Execução ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- SEGURANÇA CRÍTICA: Variáveis de Ambiente e Segredos ---
# Bloqueio explícito de todas as variações locais de arquivos de ambiente
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env

# Permissão explícita apenas para o arquivo de exemplo de estrutura
!.env.example

# --- IDEs, Editores de Texto e Ferramentas de Desenvolvimento ---
.vscode/
# Nota: Se sua equipe compartilha configurações padronizadas de extensões do VS Code,
# você pode descomentar as linhas abaixo conforme a necessidade:
# !.vscode/extensions.json
# !.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# --- Arquivos Lixo e Metadados de Sistemas Operacionais (Ruídos) ---
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini